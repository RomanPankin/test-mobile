# Copy to `.env.local` to run the app against your shop with `npm start`.
# A platform build does not read this file: it configures the app itself.

# The estore.club API.
EXPO_PUBLIC_SERVER_URL=https://estore.club

# Your shop's app key (ak_...), from the admin: Settings - For developers. It only opens what a
# customer may do, so it is safe inside an app. Never the company key (ck_...).
EXPO_PUBLIC_APP_KEY=
